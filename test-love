#!/bin/bash
# Runs the headless suite (the same one the VPS runs), then the `*_lovetest.lua` files under real LÖVE.
cd "$(dirname "$0")"
./test "$@"
status=$?
rm -f luacov.stats.out
# No window to steal focus: SDL renders offscreen. SDL_VIDEO_DRIVER=wayland (or x11) ./test-love shows it.
export SDL_VIDEO_DRIVER="${SDL_VIDEO_DRIVER:-offscreen}"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/usr/lib:$PWD/bin/linux64"
APPIMAGE_EXTRACT_AND_RUN=1 ./bin/linux64/love-linux-X64.AppImage . test "$@" || status=$?
exit $status
